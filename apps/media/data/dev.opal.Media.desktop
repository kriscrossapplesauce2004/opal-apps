[Desktop Entry]
Type=Application
Name=Media
GenericName=Media Player
Comment=Play music, videos, radio and audiobooks
Exec=opal-media %U
Icon=multimedia-player
Terminal=false
Categories=AudioVideo;Audio;Video;Player;
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/opus;audio/mp4;audio/x-wav;audio/aac;audio/x-mpegurl;
Keywords=music;video;radio;podcast;audiobook;jellyfin;
StartupWMClass=dev.opal.Media
