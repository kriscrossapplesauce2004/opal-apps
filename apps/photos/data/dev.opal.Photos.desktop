[Desktop Entry]
Type=Application
Name=Photos
GenericName=Photo Viewer
Comment=View, organise and edit your photos
Exec=opal-photos %f
Icon=dev.opal.Photos
Terminal=false
Categories=Graphics;Photography;Viewer;
Keywords=image;picture;album;gallery;camera;screenshot;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/avif;image/heif;image/tiff;
StartupWMClass=dev.opal.Photos
